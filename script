-- ============================================================================
-- TARGETING AND ENGINE UPDATE
-- ============================================================================

local function getTargetPart(character)
    if not character then return nil end
    local part = character:FindFirstChild(targetPartName)
    if not part and targetPartName == "Torso" then
        part = character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso")
    end
    return part or character:FindFirstChild("Head") 
end

local function getTarget()
    if keepLockingVictim and currentLockedTarget then
        local p = currentLockedTarget
        if p and p.Parent and p.Character and getTargetPart(p.Character) and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then return p end
        end
        currentLockedTarget = nil
    end

    local closestPlayer = nil
    local shortestDist = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local tPart = getTargetPart(p.Character)
            if tPart then
                if aimMode == "Nearest" then
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
                        local dist = (LocalPlayer.Character.Head.Position - tPart.Position).Magnitude
                        if dist < shortestDist then shortestDist = dist closestPlayer = p end
                    end
                elseif aimMode == "Center" then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(tPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if dist < shortestDist then shortestDist = dist closestPlayer = p end
                    end
                end
            end
        end
    end

    if keepLockingVictim and closestPlayer then currentLockedTarget = closestPlayer end
    return closestPlayer
end

-- ============================================================================
-- INPUT CONTROLLER
-- ============================================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.P then
        guiVisible = not guiVisible
        MainFrame.Visible = guiVisible
        if not guiVisible then SettingsFrame.Visible = false DropdownContainer.Visible = false end
        return
    end

    if isListeningForBind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            AIM_KEY = input.KeyCode isKeyboardBind = true
            btnRebind.Text = "Bound to: " .. input.KeyCode.Name isListeningForBind = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
            AIM_KEY = input.UserInputType isKeyboardBind = false
            btnRebind.Text = "Bound to: " .. input.UserInputType.Name isListeningForBind = false
        end
        return
    end

    if gpe then return end
    local activated = isKeyboardBind and (input.KeyCode == AIM_KEY) or (input.UserInputType == AIM_KEY)
    if activated then isAiming = true end
end)

UserInputService.InputEnded:Connect(function(input)
    local deactivated = isKeyboardBind and (input.KeyCode == AIM_KEY) or (input.UserInputType == AIM_KEY)
    if deactivated then
        isAiming = false
        currentLockedTarget = nil 
        LockIndicator.Enabled = false 
    end
end)

-- Main execution frame step
RunService.RenderStepped:Connect(function()
    if isAiming and aimMode ~= "None" then
        local target = getTarget()
        if target and target.Character then
            local tPart = getTargetPart(target.Character)
            if tPart then
                if showLockSymbol then
                    LockIndicator.Adornee = tPart
                    LockIndicator.Parent = ScreenGui 
                    LockIndicator.Enabled = true
                else
                    LockIndicator.Enabled = false
                end
                
                if lockToCenter then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, tPart.Position)
                else
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        local targetPos = tPart.Position
                        
                        local lookAtPosHorizontal = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
                        hrp.CFrame = CFrame.new(hrp.Position, lookAtPosHorizontal)
                        
                        local cameraPos = Camera.CFrame.Position
                        local directLookDirection = (targetPos - cameraPos).Unit
                        local finalLookDirection = Vector3.new(hrp.CFrame.LookVector.X, directLookDirection.Y, hrp.CFrame.LookVector.Z).Unit
                        
                        Camera.CFrame = CFrame.lookAt(cameraPos, cameraPos + finalLookDirection)
                    end
                end
            else
                LockIndicator.Enabled = false
            end
        else
            LockIndicator.Enabled = false 
        end
    else
        LockIndicator.Enabled = false 
    end
end)
